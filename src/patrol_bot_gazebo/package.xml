<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>patrol_bot_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo world and launch orchestration for patrol bot demo.</description>
  <maintainer email="night.patrol@example.com">night_patrol_team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>patrol_bot_description</exec_depend>
  <exec_depend>patrol_bot_navigation</exec_depend>
  <exec_depend>patrol_bot_detection</exec_depend>
  <exec_depend>patrol_bot_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
